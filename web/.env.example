# Set automatically when a Vercel Blob store is connected to the project.
# For local dev: `vercel env pull .env.local`, or paste the token from the store's page.
BLOB_READ_WRITE_TOKEN=

# Must match how the Blob store was created: private (recommended, videos show faces) or public.
BLOB_ACCESS=private

# Optional. If set, people must enter this code before they can upload (e.g. one per event).
UPLOAD_CODE=
